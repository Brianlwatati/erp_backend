{
  "name": "erp_backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ERP service — User & Access Management and Inventory, with identity delegated to IAS",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "migrate": "tsx src/database/migrate.ts",
    "db:check": "tsx src/database/db-check.ts"
  },
  "dependencies": {
    "express": "^5.0.1",
    "pg": "^8.13.1",
    "axios": "^1.7.9",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8",
    "dotenv": "^16.4.5",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.2",
    "@types/express": "^5.0.0",
    "@types/node": "^20.16.11",
    "@types/pg": "^8.11.10",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/jsonwebtoken": "^9.0.7",
    "eslint": "^8.57.1"
  }
}
