PORT=4100
NODE_ENV=development

# ERP PostgreSQL database
DATABASE_URL=postgresql://postgres:SecurePassw0rd@localhost:5432/erp_two

# IAS identity service. Do not include /api/v1 here when using the path below.
IAS_BASE_URL=http://localhost:5000
IAS_TOKEN_VERIFY_PATH=/api/v1/auth/me
IAS_PRODUCT_CODE=INVT

# Shared secret IAS uses to sign provisioning webhooks sent to ERP.
IAS_WEBHOOK_SECRET=replace-me

# MUST be identical to IAS JWT_ACCESS_SECRET.
# Used only for local JWT verification on normal ERP requests.
JWT_ACCESS_SECRET=replace-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=auth-service
JWT_AUDIENCE=auth-api



# SMTP configuration
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD =
SMTP_FROM_ADDRESS=

# whatsapp configuration
WHATSAPP_PHONE_NUMBER_ID =
WHATSAPP_ACCESS_TOKEN = 

# OpenWA configuration
OPENWA_BASE_URL =
OPENWA_API_KEY =
OPENWA_SESSION_ID =

# report delivery configuration
REPORT_DELIVERY_ENABLED= false
